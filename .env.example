# Local preview settings. Copy to .env and fill in privately; never commit real keys.
# On Netlify, set these under Site configuration → Environment variables instead.

# Stripe secret or restricted key. sk_test_… for test mode, sk_live_… for real payments.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe-webhook endpoint (optional locally).
STRIPE_WEBHOOK_SECRET=

# New-order emails (optional): a Resend API key and where to send them.
RESEND_API_KEY=
ORDER_EMAIL_TO=organicjuiceyum@gmail.com
